# Development environment. Usage: cp .env.dev.example .env && docker compose up -d --build
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL (admin at /app), plain HTTP on port 8111.
MEDUSA_URL=http://localhost:8111
SITE_ADDRESS=:80
HTTP_PORT=8111
HTTPS_PORT=8411
MAILPIT_PORT=8025
# A storefront in development (e.g. Next.js on port 8000) calling the Store API.
MEDUSA_STORE_CORS=http://localhost:8000
#MEDUSA_STOREFRONT_URL=http://localhost:8000

# Dev-only secrets and credentials.
DB_PASSWORD=medusa
MEDUSA_JWT_SECRET=dev-jwt-secret
MEDUSA_COOKIE_SECRET=dev-cookie-secret
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=admin12345

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=Tienda <shop@example.com>
