# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d --build
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=medusa

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST (the store's domain) is REQUIRED with
# it; the other three show their defaults.
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Medusa: APIs (/store, /admin, /auth), the admin
# (/app) and uploads (/static). Applied on every `up` (no rebuild needed).
MEDUSA_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# Storefronts (other origins) allowed to call the Store API, comma separated,
# e.g. https://www.example.com. MEDUSA_URL is always allowed.
#MEDUSA_STORE_CORS=
# Storefront URL for customers' password reset links
# (<url>/reset-password?token=...&email=...). Empty = no customer emails.
#MEDUSA_STOREFRONT_URL=

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 32)
# ---------------------------------------------------------------------------
DB_PASSWORD=
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
# Admin user: created if no user with that email exists (changing it later
# adds another admin); the password is only set then.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
#DB_USER=medusa
#DB_NAME=medusa
# sslmode of the database connection (the stack's PostgreSQL has no TLS).
#DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Store (initial settings, applied only on the first install)
# ---------------------------------------------------------------------------
# Store name: set once in the store's settings; the emails also read it on
# every start (header and subjects).
#MEDUSA_STORE_NAME=Medusa Store
#MEDUSA_CURRENCY=clp
#MEDUSA_COUNTRY=cl
#MEDUSA_REGION_NAME=Chile
# Default tax rate of the country (%); empty = none.
#MEDUSA_TAX_RATE=19
#MEDUSA_TAX_NAME=IVA
#MEDUSA_TAX_CODE=iva
# Prices include tax (as usual in Chile).
#MEDUSA_PRICES_INCLUDE_TAX=true
#MEDUSA_STOCK_LOCATION=Bodega
#MEDUSA_CITY=Santiago

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# @medusajs/* version of the image (image/Dockerfile); after changing it,
# `docker compose up -d --build` rebuilds and `setup` migrates. Back up first.
#MEDUSA_VERSION=2.21.1
#NODE_VERSION=24
#MEDUSA_IMAGE=medusa-stack
#POSTGRES_VERSION=18
#REDIS_VERSION=8.6
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit's web UI port (mailpit profile, development only).
#MAILPIT_PORT=8025
# Also apply unsafe link and search changes when migrating (they can drop
# tables or indexes of removed links); see README.
#MEDUSA_MIGRATE_UNSAFE=

# ---------------------------------------------------------------------------
# Mail (SMTP): admin invitations, password resets, order confirmations.
# Recommended, not required: no emails without SMTP_HOST.
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS required, usually port 587), ssl (SMTPS, port 465) or none.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender, e.g. "Tienda <shop@example.com>".
#SMTP_FROM=
# Locale of the amounts in the emails (read on every start).
#MEDUSA_LOCALE=es-CL

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#UPLOAD_MAX_SIZE=50M
#DB_MEMORY_LIMIT=1g
#REDIS_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=1g
#MEDUSA_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=768m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
